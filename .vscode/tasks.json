{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Projeyi derler (Özdisan bölümü için gerekli paketler otomatik kurulur)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/ProductSearch.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "web: çalıştır",
      "detail": "Uygulamayı http://localhost:5131 adresinde başlatır",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/ProductSearch.Web", "--urls", "http://localhost:5131"],
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
