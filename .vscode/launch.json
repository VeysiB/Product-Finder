{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web arayüzü (http://localhost:5131)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ProductSearch.Web/bin/Debug/net11.0/ProductSearch.Web.dll",
      "cwd": "${workspaceFolder}/src/ProductSearch.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5131"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
